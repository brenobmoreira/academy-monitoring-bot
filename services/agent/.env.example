# Copy to .env for local polling (uv run agent-poll). Never commit .env.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
SHEET_API_URL=https://script.google.com/macros/s/<deploymentId>/exec
SHEET_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini through Vertex AI (uses your gcloud application-default credentials locally)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ...or through AI Studio instead: set GOOGLE_GENAI_USE_VERTEXAI=FALSE and
# GOOGLE_API_KEY=
