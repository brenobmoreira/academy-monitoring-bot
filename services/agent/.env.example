# Copy to .env for local runs (uv run agent-poll, e2e/run.py --real). Never commit .env.
# Non-secret settings live in settings.yaml; any of them can be overridden here.

# Model key for the provider in LLM_MODEL (settings.yaml). AI Studio: https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5
# LLM_API_BASE=http://localhost:4000          # LiteLLM proxy or self-hosted model

TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
SHEET_API_URL=https://script.google.com/macros/s/<deploymentId>/exec
SHEET_API_KEY=
# Only for POST /remind (Cloud Scheduler reminders, `make remind`); unset = endpoint off (404).
# REMINDER_TOKEN=
