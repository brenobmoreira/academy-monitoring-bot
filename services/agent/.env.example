# Copy to .env for local runs (uv run agent-poll, make serve, make serve-voice).
# WARNING: NEVER commit .env to version control! Keep secrets local and out of git.
# Non-secret settings live in settings.yaml; any of them can be overridden here.

# Model key for the provider in LLM_MODEL (settings.yaml). AI Studio: https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5
# LLM_API_BASE=http://localhost:4000          # LiteLLM proxy or self-hosted model

TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
SHEET_API_URL=https://script.google.com/macros/s/<deploymentId>/exec
SHEET_API_KEY=
# Only for POST /remind (Cloud Scheduler reminders, `make remind`); unset = endpoint off (404).
# REMINDER_TOKEN=

# --- Mini App voice integration in the bot (optional) -------------------------
# Set both to enable the microphone button and session signing in the bot (/app).
# When VOICE_API_URL is unset, the Mini App hides the voice input button.
# VOICE_API_URL=https://fitness-voice-<client>-<hash>-<region>.a.run.app
# APP_AUTH_SECRET must be at least 32 characters/bytes, shared between bot and voice service:
# APP_AUTH_SECRET=your-secret-at-least-32-chars-long
# Transcription key for chat voice notes (if using Gemini and not covered by LLM_API_KEY):
# TRANSCRIBE_API_KEY=
# Alternatively, LiteLLM recognizes GEMINI_API_KEY / GOOGLE_API_KEY from environment:
# GEMINI_API_KEY=

# --- Standalone voice service (agent.voice_asgi:app / Dockerfile.voice) --------
# Only needed when running the standalone voice service locally (make serve-voice)
# or in Cloud Run. Requires APP_AUTH_SECRET, ALLOWED_CHAT_IDS, VOICE_ALLOWED_ORIGINS
# and TRANSCRIBE_API_KEY (or GEMINI_API_KEY).
# VOICE_API_ENABLED=true
# Transcription API key for Gemini calls made directly by the voice service:
# TRANSCRIBE_API_KEY=
# Fallback if TRANSCRIBE_API_KEY is unset (LiteLLM also reads GEMINI_API_KEY / GOOGLE_API_KEY):
# GEMINI_API_KEY=
# Comma-separated list of allowed HTTPS origins (no wildcards or paths):
# VOICE_ALLOWED_ORIGINS=https://your-username.github.io
# Model for audio transcription (default: gemini/gemini-3.8-flash):
# TRANSCRIBE_MODEL=gemini/gemini-3.8-flash
# Optional in-memory budgets and rate limits (defaults match spec §5.5, §5.6):
# VOICE_DAILY_TOKENS=120000
# VOICE_GLOBAL_DAILY_TOKENS=500000
# VOICE_MAX_SECONDS=90          # Duração máxima do áudio em segundos (D2), não timeout de rede
# VOICE_MAX_BYTES=1500000
# VOICE_RATE_PER_MIN=6
# VOICE_RATE_PER_DAY=60
# VOICE_MAX_CONCURRENT=4
# VOICE_IDEMPOTENCY_TTL_S=300
# EXCHANGE_RATE_PER_MIN=30
# EXCHANGE_RATE_PER_DAY=20
